  "main": "dist-electron/main.js",
  "scripts": {
    "build:electron": "tsc electron/main.ts electron/preload.ts --outDir dist-electron --target ES2022 --module CommonJS --moduleResolution node --esModuleInterop --skipLibCheck",
    "build:vite": "vite build",
    "build": "npm run build:vite && npm run build:electron",
    "vite": "vite",
    "electron": "wait-on http://localhost:5173 && electron .",
    "dev": "npm run build:electron && concurrently -k \"npm run vite\" \"npm run electron\"",
    "start-py": "C:\\Users\\abira\\AppData\\Local\\Programs\\Python\\Python312\\python.exe python-service/run.py",
    "install-models": "C:\\Users\\abira\\AppData\\Local\\Programs\\Python\\Python312\\python.exe -c \"import faster_whisper; faster_whisper.WhisperModel('base.en')\" && ollama pull qwen2.5:3b"
  },
  "dependencies": {
